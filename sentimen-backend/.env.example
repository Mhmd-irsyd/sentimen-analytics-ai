PROJECT_NAME="Sentimen Analytics AI"
API_V1_STR="/api/v1"
PORT=8000
HOST="0.0.0.0"
DEBUG=True

# Path to the local fine-tuned IndoBERT model
MODEL_PATH="./model_sentimen"

# Device configuration: 'auto', 'cuda', or 'cpu'
DEVICE="auto"

# Max batch size for inference
BATCH_SIZE=32

# CORS allowed origins (comma separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# RapidAPI Instagram Configuration (Optional)
RAPIDAPI_KEY="your_rapidapi_key_here"
RAPIDAPI_HOST="instagram-best-experience.p.rapidapi.com"
